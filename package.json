{
  "name": "sequence-control-tower",
  "version": "0.12.2",
  "private": true,
  "description": "Local-first log parsing workbench for Windows and macOS validation engineers",
  "author": "stpcoder",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "npm run typecheck && vite build",
    "docs:dev": "vitepress dev docs/manual",
    "docs:build": "vitepress build docs/manual",
    "docs:preview": "vitepress preview docs/manual",
    "dist:win": "npm run build && electron-builder --win nsis portable zip --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never"
  },
  "dependencies": {
    "@fontsource/pretendard": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode-ai/sdk": "^1.18.15",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.stpcoder.sequencecontroltower",
    "productName": "Sequence Control Tower",
    "asar": true,
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "agent-skills",
        "to": "agent-skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
