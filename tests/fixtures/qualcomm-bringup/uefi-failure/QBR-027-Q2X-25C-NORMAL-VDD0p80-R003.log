STRESSAPP PASS
tSKHYNIX_MARCH_BASELINE, ADDR=0x1000a040, AP=1, IDX=0x2, CS=1, BK=3, ROW=0x1234, COL=0x40, WR=0x51000a1b, RD=0x51000a1b;
tSKHYNIX_RANDOM_BASELINE ADDR=0x1000a080 AP=0 IDX=3 CS=0 BK=2 ROW=0x2000 COL=0x80 WR=0x1122334455667788 RD=0x1122334455667788;
END_SYNTHETIC_RECORD=true;
